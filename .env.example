# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Security Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your-base64-encoded-32-byte-encryption-key
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-hex-encoded-32-byte-jwt-secret

# Application Configuration
TAX_RATE=0.08875
PORT=5000
VITE_PORT=5173
BASE_PATH=/

# Environment
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins for cross-origin requests
ALLOWED_ORIGINS=http://localhost:5173

# Square Payment Configuration
# Get these from the Square Developer Dashboard: https://developer.squareup.com
# VITE_SQUARE_APPLICATION_ID: Your Square application ID (for frontend)
# SQUARE_LOCATION_ID: Your Square location ID
# SQUARE_ACCESS_TOKEN: Your Square access token (never commit actual tokens)
# SQUARE_ENVIRONMENT: sandbox for development, production for live payments
VITE_SQUARE_APPLICATION_ID=sq0idp-your-application-id
SQUARE_LOCATION_ID=your-location-id
SQUARE_ACCESS_TOKEN=your-access-token
SQUARE_ENVIRONMENT=sandbox

# Redis Caching Configuration
# Redis connection URL for caching layer
# Format: redis://localhost:6379 or redis://user:password@host:port
# For production, use a managed Redis service (e.g., Redis Cloud, AWS ElastiCache)
REDIS_URL=redis://localhost:6379

# Twilio Configuration
# Get these from the Twilio Console: https://console.twilio.com
# TWILIO_ACCOUNT_SID: Your Twilio Account SID
# TWILIO_AUTH_TOKEN: Your Twilio Auth Token (never commit actual tokens)
# Used for SMS notifications and health checks
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token

# Logging Configuration
# Controls the verbosity of application logs
# Valid values: error, warn, info, debug
# - error: Only error messages
# - warn: Warnings and errors
# - info: General information (default)
# - debug: Detailed debugging information
LOG_LEVEL=info
