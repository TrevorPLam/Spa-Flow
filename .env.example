# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Database Connection Pool Configuration
# DB_POOL_MAX: Maximum number of connections in the pool (default: 20)
# Recommended: 10-50 depending on your database server capacity and application load
# Higher values allow more concurrent queries but consume more database resources
DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT_MS: Time in milliseconds before idle connections are closed (default: 30000)
# Recommended: 30000 (30 seconds) to balance connection reuse and resource cleanup
# Too low: Frequent connection establishment overhead
# Too high: Idle connections consume database resources
DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS: Time in milliseconds to wait when acquiring a connection (default: 5000)
# Recommended: 2000-10000 (2-10 seconds) depending on your application's tolerance for delays
# If timeout is reached, an error will be thrown
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Database Transaction Timeout Configuration
# DB_STATEMENT_TIMEOUT_MS: Time in milliseconds before a single SQL statement is terminated (default: 30000)
# Recommended: 30000 (30 seconds) for most applications
# Prevents long-running queries from consuming database resources
# Error message: "canceling statement due to statement timeout"
DB_STATEMENT_TIMEOUT_MS=30000
# DB_LOCK_TIMEOUT_MS: Time in milliseconds to wait for a lock before giving up (default: 5000)
# Recommended: 5000 (5 seconds) to prevent lock queue issues
# Prevents cascading lock wait chains, especially important for DDL operations
# Error message: "canceling statement due to lock timeout"
DB_LOCK_TIMEOUT_MS=5000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS: Time in milliseconds a session can be idle within a transaction (default: 60000)
# Recommended: 60000 (60 seconds) to prevent abandoned transactions
# Prevents transactions from holding locks while waiting for application processing
# Error message: "terminating connection due to idle-in-transaction timeout"
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# Security Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your-base64-encoded-32-byte-encryption-key
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-hex-encoded-32-byte-jwt-secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CSRF_SECRET=your-base64-encoded-32-byte-csrf-secret

# Application Configuration
TAX_RATE=0.08875
VITE_TAX_RATE=0.08875
PORT=5000
VITE_PORT=5173
BASE_PATH=/

# API URL Configuration
# API_BASE_URL: Base URL for the API server (used by backend, tests, and load tests)
# Format: http://localhost:5000 or https://api.example.com
# For production, use your actual API server URL
API_BASE_URL=http://localhost:5000
# VITE_API_URL: Base URL for the API server (used by frontend Vite proxy)
# Format: http://localhost:5000 or https://api.example.com
# Must match API_BASE_URL in most cases
# VITE_ prefix makes this available to frontend code
VITE_API_URL=http://localhost:5000

# Request Timeout Configuration
# Maximum time (in seconds) allowed for a request to complete before timing out
# Format: number followed by 's' (e.g., 30s for 30 seconds)
# Recommended: 30s for most applications, adjust based on your use case
REQUEST_TIMEOUT=30s

# Environment
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins for cross-origin requests
# Security Policy: Requests without Origin header are blocked in production (prevents null origin bypass attacks)
# In development, no-origin requests are allowed for testing tools (curl, Postman, etc.)
# Mobile apps and non-browser clients should include proper Origin headers or use API keys
ALLOWED_ORIGINS=http://localhost:5173

# Square Payment Configuration
# Get these from the Square Developer Dashboard: https://developer.squareup.com
# VITE_SQUARE_APPLICATION_ID: Your Square application ID (for frontend)
# VITE_SQUARE_LOCATION_ID: Your Square location ID (for frontend Web Payments SDK)
#   Format: Short generated string of letters and numbers (e.g., 3Z4V4WHQK64X9)
#   Find it: Developer Dashboard → Your Application → Locations
# SQUARE_LOCATION_ID: Your Square location ID (for backend API calls)
# SQUARE_ACCESS_TOKEN: Your Square access token (never commit actual tokens)
# SQUARE_ENVIRONMENT: sandbox for development, production for live payments
# SQUARE_API_VERSION: Square API version in YYYY-MM-DD format (default: 2025-08-20)
# See https://developer.squareup.com/docs/build-basics/versioning-overview for details
VITE_SQUARE_APPLICATION_ID=sq0idp-your-application-id
VITE_SQUARE_LOCATION_ID=your-location-id
SQUARE_LOCATION_ID=your-location-id
SQUARE_ACCESS_TOKEN=your-access-token
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2025-08-20

# Redis Caching Configuration
# Redis connection URL for caching layer
# Format: redis://localhost:6379 or redis://user:password@host:port
# For production, use a managed Redis service (e.g., Redis Cloud, AWS ElastiCache)
REDIS_URL=redis://localhost:6379

# Twilio Configuration
# Get these from the Twilio Console: https://console.twilio.com
# TWILIO_ACCOUNT_SID: Your Twilio Account SID
# TWILIO_AUTH_TOKEN: Your Twilio Auth Token (never commit actual tokens)
# TWILIO_PHONE_NUMBER: Your Twilio phone number in E.164 format (e.g., +14155552671)
# Used for SMS notifications and health checks
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+14155552671

# Email Configuration (Resend)
# Get your API key from the Resend dashboard: https://resend.com/api-keys
# RESEND_API_KEY: Your Resend API key (never commit actual keys)
# EMAIL_FROM_ADDRESS: The email address to send emails from (must be verified in Resend)
# EMAIL_FROM_NAME: The display name for the sender (default: SpaFlow)
# Used for password reset emails and other transactional emails
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=SpaFlow

# Logging Configuration
# Controls the verbosity of application logs
# Valid values: error, warn, info, debug
# - error: Only error messages
# - warn: Warnings and errors
# - info: General information (default)
# - debug: Detailed debugging information
LOG_LEVEL=info

# Sentry Error Tracking Configuration
# Get your DSN from the Sentry dashboard: https://sentry.io
# SENTRY_DSN: Your Sentry Data Source Name (never commit actual DSNs)
# SENTRY_ENVIRONMENT: Environment name (e.g., development, staging, production)
# SENTRY_RELEASE: Release version for error tracking (optional)
# SENTRY_AUTH_TOKEN: Auth token for uploading source maps (create in Sentry dashboard)
SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=1.0.0
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# Account Lockout Configuration
# LOCKOUT_THRESHOLD: Number of failed login attempts before account lockout (default: 5)
# Recommended: 3-10 depending on security requirements
# Too low: Users may get locked out due to typos
# Too high: Reduces effectiveness against brute force attacks
LOCKOUT_THRESHOLD=5
# LOCKOUT_DURATION_MS: Lockout duration in milliseconds (default: 900000 = 15 minutes)
# Recommended: 900000 (15 min) to 3600000 (1 hour)
# Too short: Attackers can retry after short wait
# Too long: Poor user experience for legitimate users
LOCKOUT_DURATION_MS=900000

# Authentication Configuration
# JWT_EXPIRY: Access token expiration time (default: 15m)
# Format: number followed by unit (s=seconds, m=minutes, h=hours, d=days)
# Recommended: 15m per JWT security best practices (reduces attack window)
# Too long: Increases security risk if token is compromised
# Too short: Poor user experience with frequent re-authentication
JWT_EXPIRY=15m
# COOKIE_NAME: Name of the HTTP-only cookie for session token (default: spaflow_session)
# Recommended: Use application-specific name to avoid conflicts
# Must match between frontend and backend
COOKIE_NAME=spaflow_session
# REFRESH_TOKEN_EXPIRY_DAYS: Number of days refresh tokens are valid (default: 7)
# Recommended: 7-14 days per security best practices
# Too long: Increases security risk if refresh token is compromised
# Too short: Poor user experience with frequent re-login
REFRESH_TOKEN_EXPIRY_DAYS=7

# Session Configuration
# SESSION_DURATION_HOURS: Default session duration in hours (default: 6)
# Recommended: 6 hours for typical spa sessions
# Too short: Poor user experience for longer treatments
# Too long: May reduce resource availability
SESSION_DURATION_HOURS=6
# EXTENSION_DURATION_HOURS: Extension duration in hours (default: 2)
# Recommended: 2 hours for session extensions
# Too short: Users may need more time for treatments
# Too long: May reduce resource availability for others
EXTENSION_DURATION_HOURS=2
# WAITLIST_CONFIRM_MINUTES: Waitlist confirmation window in minutes (default: 15)
# Recommended: 15 minutes for users to confirm waitlist assignment
# Too short: Users may miss notifications
# Too long: Resources held unnecessarily
WAITLIST_CONFIRM_MINUTES=15

# Pricing Configuration
# MEMBERSHIP_ONE_TIME_COST: Cost of one-time membership in dollars (default: 13)
# Recommended: 13 dollars for single-use membership
# Adjust based on market pricing and business strategy
MEMBERSHIP_ONE_TIME_COST=13
# MEMBERSHIP_SIX_MONTH_COST: Cost of six-month membership in dollars (default: 42)
# Recommended: 42 dollars for six-month membership
# Adjust based on market pricing and business strategy
MEMBERSHIP_SIX_MONTH_COST=42
# EXTENSION_SURCHARGE_DIVISOR: Divisor for extension surcharge calculation (default: 3)
# Recommended: 3 (surcharge is 1/3 of base rate)
# Higher values reduce surcharge, lower values increase it
EXTENSION_SURCHARGE_DIVISOR=3

# Pagination Configuration
# DEFAULT_PAGE_SIZE: Default number of items per page for paginated endpoints (default: 20)
# Recommended: 20 items for optimal performance and UX
# Too low: More API calls required
# Too high: Slower response times and larger payloads
DEFAULT_PAGE_SIZE=20

# Seed Script Configuration
# ADMIN_PASSWORD: Password for the default admin user (admin@spaflow.com)
# REQUIRED for running the seed script
# Generate a strong password: Use a password manager or generate with: openssl rand -base64 16
# Minimum 12 characters with mixed case, numbers, and special characters
ADMIN_PASSWORD=your-secure-admin-password
# STAFF_PASSWORD: Password for the default staff user (staff@spaflow.com)
# REQUIRED for running the seed script
# Generate a strong password: Use a password manager or generate with: openssl rand -base64 16
# Minimum 12 characters with mixed case, numbers, and special characters
STAFF_PASSWORD=your-secure-staff-password
