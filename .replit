modules = ["nodejs-24"]

[deployment]
router = "none"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3000 pnpm --filter @workspace/api-server run dev & PORT=5000 BASE_PATH=/ pnpm --filter @workspace/spaflow run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
ENCRYPTION_KEY = "T/2AwPPGwpuLm+z5CNyb2sfSm5lLaGhso0ewX7KGp2s="
JWT_SECRET = "grA0sIbVPwxYyNTBats9qGSfuT8jEctWXiszfKayBjYntdkgCBOWhcZSsxvJiXKM"
CSRF_SECRET = "T/2AwPPGwpuLm+z5CNyb2sfSm5lLaGhso0ewX7KGp2s="
TAX_RATE = "0.08875"

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 20811
externalPort = 3000

[nix]
channel = "stable-25_05"
