{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');['package-lock.json','yarn.lock'].forEach(f=>fs.existsSync(f)&&fs.unlinkSync(f));if(!process.env.npm_config_user_agent?.includes('pnpm')){console.error('Use pnpm instead');process.exit(1)}\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "format": "pnpm -r --if-present run format",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "test:changed": "pnpm -r --filter \"...[origin/main]\" --if-present run test:changed",
    "test:affected": "pnpm -r --filter \"...[origin/main]\" --if-present run test",
    "test:load:smoke": "k6 run load-tests/smoke.js",
    "test:load:health": "k6 run load-tests/health-check.js",
    "test:load:clients": "k6 run load-tests/client-search.js",
    "test:load:dashboard": "k6 run load-tests/dashboard.js",
    "test:load:checkin": "k6 run load-tests/checkin-flow.js",
    "test:load:benchmark": "k6 run load-tests/benchmark.js",
    "test:load:peak": "k6 run load-tests/peak-hours.js",
    "test:load:all": "k6 run load-tests/health-check.js && k6 run load-tests/client-search.js && k6 run load-tests/dashboard.js && k6 run load-tests/checkin-flow.js"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
